+void FileExpertSource::ram_lru_complete(int64_t layer, const int32_t* ids, const int32_t* kind,
+    int64_t n, const int32_t* host_res, const int16_t* job_of, const strata::kernels::cpu::ExpertJobMulti* jobs) {
+    if (!ram_lru_enabled_) return;
+    // Called after synchronous CPU jobs. Current GPU/PCIe routes and pending adaptive copies
+    // are never victims. Same-layer slots have identical byte sizes; no arena reallocation.
+    if (layer < 0 || layer >= n_layers_ || !host_res || n <= 0) std::abort();
+    ++ram_lru_clock_;
+    const size_t base = (size_t)layer * (size_t)n_expert_;
+    for (int64_t i = 0; i < n; ++i) {
+        const int32_t e = ids[i];
+        if (e >= 0 && e < n_expert_ && kind[i] != -2 && resident_blob(base + e))
+            ram_lru_touch_[base + e] = ram_lru_clock_;
+    }
+    auto protected_pair = [&](size_t pair) {
+        if (host_res[pair] >= 0 || (!override_.empty() && override_[pair])) return true;
+        for (const Exchange& x : staged_) if (x.in == pair || x.out == pair) return true;
+        return false;
+    };
+    for (int64_t i = 0; i < n; ++i) {
+        const int32_t e = ids[i];
+        if (e < 0 || e >= n_expert_ || kind[i] != -1) continue;
+        const size_t incoming = base + e;
+        if (resident_blob(incoming) || protected_pair(incoming)) continue;
+        const int16_t job = job_of[e];
+        if (job < 0 || jobs[job].blob == nullptr) std::abort();
+        size_t victim = complement_offsets_.size();
+        uint64_t oldest = ~0ull;
+        for (int64_t candidate = 0; candidate < n_expert_; ++candidate) {
+            const size_t pair = base + (size_t)candidate;
+            if (complement_offsets_[pair] == kNoComplement || protected_pair(pair)) continue;
+            bool routed = false;
+            for (int64_t q = 0; q < n; ++q) if (ids[q] == candidate) { routed = true; break; }
+            if (routed) continue;
+            if (ram_lru_touch_[pair] < oldest) { oldest = ram_lru_touch_[pair]; victim = pair; }
+        }
+        if (victim == complement_offsets_.size()) { ++ram_lru_no_victim_; continue; }
+        const uint64_t at = complement_offsets_[victim], bytes = layer_blob_bytes_[(size_t)layer];
+        if (at > complement_bytes_ || bytes > complement_bytes_ - at) std::abort();
+        uint8_t* destination = (uint8_t*)complement_host_ + (size_t)at;
+        std::memcpy(destination, jobs[job].blob, (size_t)bytes);
+        if (ram_lru_check_ && std::memcmp(destination, jobs[job].blob, (size_t)bytes) != 0) std::abort();
+        complement_offsets_[victim] = kNoComplement;
+        complement_offsets_[incoming] = at;
+        ram_lru_touch_[incoming] = ram_lru_clock_;
+        ++ram_lru_admissions_;
+        ram_lru_copy_bytes_ += bytes;
+    }
+    if (layer == n_layers_ - 1 && ram_lru_clock_ % (48 * 128) == 0)
+        std::fprintf(stderr, "RAM_LRU admissions=%llu copy_MB=%.3f no_victim=%llu checked=%d\n",
+            (unsigned long long)ram_lru_admissions_, (double)ram_lru_copy_bytes_ / 1e6,
+            (unsigned long long)ram_lru_no_victim_, ram_lru_check_ ? 1 : 0);
+}
